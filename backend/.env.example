# PalmView Backend — Environment Variables
# Copy this file to .env and fill in your values
# All vars use GEO_ prefix (pydantic-settings)

# ── Database ──────────────────────────────────────────────────────────
# For local dev with docker compose:
GEO_DATABASE_URL=postgresql://palmview:RlICGo8ARMyYFc2FLQva@localhost:5434/palmview
# For Docker-internal service communication:
# GEO_DATABASE_URL=postgresql://palmview:RlICGo8ARMyYFc2FLQva@postgres:5432/palmview

# ── Inference ─────────────────────────────────────────────────────────
# Backend mode: "local" | "modal" | "mock"
GEO_INFERENCE_BACKEND=local
GEO_INFERENCE_API_URL=http://localhost:8001

# TiTiler COG tile server (port 8003)
TITILER_BASE_URL=http://localhost:8003

# Modal serverless GPU (for production)
# GEO_MODAL_TOKEN_ID=ak-xxx
# GEO_MODAL_TOKEN_SECRET=as-xxx
# GEO_MODAL_APP_NAME=palmview-inference

# ── Storage ───────────────────────────────────────────────────────────
# "local" = store files on disk; "s3" = use MinIO or S3-compatible
GEO_STORAGE_BACKEND=s3

# MinIO (local dev, docker compose):
GEO_S3_BUCKET=palmview-assets
GEO_S3_ENDPOINT=http://localhost:9000
GEO_S3_REGION=us-east-1
GEO_S3_ACCESS_KEY=palmview
GEO_S3_SECRET_KEY=RlICGo8ARMyYFc2FLQva

# Production S3 / Cloudflare R2 (uncomment and fill):
# GEO_S3_BUCKET=your-bucket-name
# GEO_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# GEO_S3_REGION=auto
# GEO_S3_ACCESS_KEY=your-access-key
# GEO_S3_SECRET_KEY=your-secret-key

# ── CORS / API ────────────────────────────────────────────────────────
GEO_ALLOWED_ORIGINS=["http://localhost:8080","http://localhost:3000"]

# ── Google Earth Engine ───────────────────────────────────────────────
GEO_GEE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GEO_GEE_SERVICE_ACCOUNT_KEY_FILE=./credentials/your-key.json
GEO_GEE_PROJECT=your-gcp-project-id

# ── ML / Inference ────────────────────────────────────────────────────
# GEO_CLIP_WEIGHTS_PATH=../ml/weights/RemoteCLIP-ViT-L-14.pt
# GEO_TILE_DATA_DIR=../data/johor_s2

# ── Redis (optional, for caching) ────────────────────────────────────
# GEO_REDIS_URL=redis://localhost:6379/0
