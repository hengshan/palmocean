[Unit]
Description=PalmView Frontend (static file server)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/hank/projects/palmview
ExecStart=/usr/bin/python3 -m http.server 8080 --bind 0.0.0.0 --directory /home/hank/projects/palmview/app/dist
Restart=always
RestartSec=5
StandardOutput=append:/home/hank/logs/palmview/frontend.log
StandardError=append:/home/hank/logs/palmview/frontend.log

[Install]
WantedBy=default.target
