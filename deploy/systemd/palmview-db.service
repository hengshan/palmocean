[Unit]
Description=PalmView DB + MinIO (docker compose)
After=network.target docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=hank
WorkingDirectory=/home/hank/projects/palmview
ExecStart=/usr/bin/docker compose up -d postgres minio
ExecStop=/usr/bin/docker compose stop postgres minio
StandardOutput=append:/var/log/palmview/db.log
StandardError=append:/var/log/palmview/db.log

[Install]
WantedBy=multi-user.target
