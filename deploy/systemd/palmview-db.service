[Unit]
Description=PalmView DB + MinIO (docker compose)
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/hank/projects/palmview
ExecStart=/usr/bin/docker compose up -d postgres minio
ExecStop=/usr/bin/docker compose stop postgres minio
StandardOutput=append:/home/hank/logs/palmview/db.log
StandardError=append:/home/hank/logs/palmview/db.log

[Install]
WantedBy=default.target
