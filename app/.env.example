# PalmView Frontend (Kepler.gl app) — Environment Variables
# Copy this file to .env and fill in your values
# Used by esbuild at build time via --define

# ── Mapbox ────────────────────────────────────────────────────────────
# Required: get a token at https://account.mapbox.com/
MapboxAccessToken=pk.your_mapbox_public_token_here
MapboxExportToken=pk.your_mapbox_public_token_here

# ── Backend API ───────────────────────────────────────────────────────
PALMVIEW_API_URL=http://localhost:8000
